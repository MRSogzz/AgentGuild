# ============================================================
# Agent Office — Git 忽略清單
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---------- 虛擬環境 ----------
venv/
office/
env/
ENV/
.python-version

# ---------- 測試與快取 ----------
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---------- 環境變數與機密 ----------
.env
.env.local
.env.*.local
*.key
*.pem

# ============================================================
# Agent Office 執行時產物
# ============================================================

# ---------- 會話歷史（每位使用者本機產生） ----------
sessions/
!sessions/.gitkeep

# ---------- 長期記憶（本機累積的事實） ----------
memory/
!memory/.gitkeep

# ---------- 日誌與 trace ----------
logs/
!logs/.gitkeep

# ---------- 工作區沙箱（Agent 產出的程式碼與測試） ----------
workspace/
!workspace/.gitkeep

# ---------- RAG 索引快取（自動重建） ----------
docs/_index.json

# ---------- 模型檔案（太大，不進 git） ----------
models/
*.gguf
*.ggml
*.bin
*.safetensors

# ============================================================
# 前端（若日後引入 npm）
# ============================================================
node_modules/
package-lock.json
yarn.lock
dist/
.vite/
.next/
.nuxt/

# ============================================================
# IDE / 編輯器
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
*.sublime-workspace
*.sublime-project

# ============================================================
# 作業系統
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================================================
# 其他
# ============================================================
*.log
*.tmp
*.bak
*.orig
*.rej